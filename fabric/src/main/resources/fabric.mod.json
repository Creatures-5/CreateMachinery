{
  "schemaVersion": 1,
  "id": "create_machinery",
  "version": "${version}",
  "name": "Create: Immersive Machinery",
  "description": "A fork of Immersive Machinery aimed at integration with Create",
  "authors": [
    "Creatures-5"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/create-immersive-machinery",
    "sources": "https://github.com/Creatures-5/CreateMachinery",
    "issues": "https://github.com/Creatures-5/CreateMachinery/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "create_machinery.fabric.CommonFabric"
    ],
    "client": [
      "create_machinery.fabric.ClientFabric"
    ],
    "modmenu": [
      "create_machinery.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "create_machinery.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.11.3",
    "java": ">=8",
    "fabric-api-base": ">=0.1.0",
    "immersive_aircraft": ">=1.2.0"
  }
}
